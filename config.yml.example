# Mi Node 配置示例
# 复制为 config.yml 后按需修改

# ══════════════════════════════════════════════════════════════════════════════
# 最小配置（推荐）
# 节点 ID、内核、TLS、规则等大部分配置都可以由面板统一下发。
# ══════════════════════════════════════════════════════════════════════════════

# 面板连接配置
panel:
  # Mi 面板地址（必填）
  url: "https://panel.example.com"
  # 节点通信令牌（必填，需与面板设置一致）
  token: "your-server-token"
  # 面板中的节点 ID
  node_id: 1

# 内核配置（可选）
kernel:
  # 内核类型: "singbox"（默认）或 "xray"
  type: "singbox"
  # 生成配置与运行时文件的目录（默认: /etc/mi-node）
  config_dir: "/etc/mi-node"
  # 内核日志等级: debug/info/warn/error（默认 warn，可被面板覆盖）
  log_level: "warn"
  # 默认出口与防滥用规则（可选）
  # egress:
  #   # 默认 true：启用仓库内置的私网 / BT / 域名黑名单拦截规则
  #   enable_default_rules: true
  #   # 默认 true：按仓库策略优先使用 IPv4 出站
  #   prefer_ipv4: true
  #   socks5:
  #     address: "127.0.0.1"
  #     port: 1080
  #     # username: "your-user"
  #     # password: "your-pass"
  #   # socks5 和 shadowsocks 只能二选一
  #   shadowsocks:
  #     uri: "ss://MjAyMi1ibGFrZTMtYWVzLTI1Ni1nY206ODhvMGZwK3BBV29XS3ZrRGUydWhxek4zcDE3Uk5mQzdhSE0wVldJTUtuZz06UnlObkhsZ3lLT3ZKVzRCWVY5TnhWMDlMWkhnWGM1Ui9wamxKSjRPR3QyND0=@38.182.122.32:37605?type=tcp#egress"
  #     # 传统 SS 示例：
  #     # uri: "ss://YWVzLTEyOC1nY206eW91ci1wYXNzd29yZA==@127.0.0.1:8388"

# TLS 证书配置（可选，也可交由面板下发）
# cert_mode: "http" | "dns" | "self" | "file" | "none"
#   http  - 使用 ACME HTTP-01 验证（要求 80 端口可被公网访问）
#   dns   - 使用 ACME DNS-01 验证（支持通配符证书，需配置 dns_provider）
#   self  - 生成自签名证书（有效期 10 年，无外部依赖）
#   file  - 手动指定 cert_file / key_file
#   none  - 不启用 TLS（默认）
# 对于 TUIC / Hysteria / AnyTLS 或面板下发 TLS=1 的协议，
# 如果这里和面板都没有提供证书，节点会自动回退为自签名证书。
cert:
  cert_mode: "none"
  # ACME 或自签名证书使用的域名
  # domain: "node.example.com"
  # ACME 注册邮箱
  # email: "admin@example.com"

  # ── HTTP-01 模式 ──
  # cert_mode: "http"
  # http_port: 80               # ACME HTTP-01 本地监听端口（默认 80）
  # 如改成 8080，仍需保证公网 80 已转发到本机 8080
  # 需要域名已解析到当前服务器，且 80 端口可被公网访问

  # ── DNS-01 模式 ──
  # cert_mode: "dns"
  # dns_provider: "cloudflare"   # 支持: cloudflare, alidns
  # dns_env:                     # 提供商所需凭据
  #   CF_API_TOKEN: "your-cloudflare-api-token"
  # 适合被 CDN 代理、80 端口不可用，或需要通配符证书的场景

  # ── 文件证书模式 ──
  # cert_file: "/etc/ssl/certs/cert.pem"
  # key_file: "/etc/ssl/private/key.pem"

  # 自动证书存储目录（默认: {config_dir}/certs）
  # cert_dir: "/etc/mi-node/certs"

# 日志配置
log:
  # 节点日志等级: debug/info/warn/error（默认 info）
  level: "info"
  # 日志输出位置: stdout/stderr 或文件路径（默认 stdout）
  output: "stdout"

# 运行时内存调优（可选）
# 推荐用于本机直接部署的小内存机器。
runtime:
  # Go 运行时软内存上限，例如 "256MiB"、"512MiB"
  # 留空表示不限制
  gomemlimit: ""
  # GOGC 百分比，默认 100；值越小越省内存，但 CPU 开销会更高
  gogc: 0

# ══════════════════════════════════════════════════════════════════════════════
# 高级 / 多节点模式
# 使用一份配置文件运行多个节点，每个节点拥有独立工作目录。
# 注意: 多节点模式下 `kernel.type` 为全局共享，不支持按节点分别切换 singbox/xray。
# ══════════════════════════════════════════════════════════════════════════════
# 当存在 `nodes:` 时，顶层 `panel.node_id` 会被忽略。
#
# nodes:
#   - node_id: 1
#   - node_id: 2
#     # 每个节点都可以单独覆盖部分配置
#     node_type: "shadowsocks"
#     kernel:
#       config_dir: "/etc/mi-node/node-2"
#       log_level: "info"
#
#   - node_id: 3
#     kernel:
#       config_dir: "/etc/mi-node/node-3"
#     cert:
#       domain: "node3.example.com"
#       auto_tls: true

# 健康检查端口（Docker / K8s 场景可选，0 表示关闭）
# health_port: 65530

# 本地调试端口（仅监听 127.0.0.1，返回默认出站 tag、SS 上游和最近一次默认出站拨号检查结果）
# debug_port: 65531
